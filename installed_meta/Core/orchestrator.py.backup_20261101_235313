import asyncio
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path

import httpx

OLLAMA = "http://127.0.0.1:11434/api/chat"

@dataclass
class Agent:
    name: str
    model: str
    instruction: str
    history: list = field(default_factory=list)
    max_tokens: int = 350

    async def run(self, client, task, context=""):
        prompt = (
            f"ЗАДАЧА:\n{task}\n\n"
            f"РЕЗУЛЬТАТЫ ДРУГИХ АГЕНТОВ:\n{context[:4500]}"
        )

        messages = [
            {"role": "system", "content": self.instruction},
            {"role": "user", "content": prompt}
        ]

        response = await client.post(
            OLLAMA,
            json={
                "model": self.model,
                "stream": False,
                "messages": messages,
                "options": {
                    "num_ctx": 4096,
                    "num_predict": self.max_tokens,
                    "temperature": 0.2
                }
            }
        )
        response.raise_for_status()

        data = response.json()
        message = data.get("message", {})
        answer = message.get("content", "").strip()

        if not answer:
            raise RuntimeError(
                f"{self.name}: модель вернула пустой ответ"
            )

        self.history.extend([
            messages[-1],
            {"role": "assistant", "content": answer}
        ])
        return answer


def create_team():
    common = (
        "Ты самостоятельный агент системы META. "
        "Отвечай по-русски, кратко и конкретно. "
        "Ты получаешь результаты других агентов, "
        "но не их личную историю сообщений. "
        "Не утверждай, что выполнил действия с файлами, "
        "запустил код или проверил факты, если этого не делал."
    )

    specs = [
        (
            "Planner",
            "qwen2.5:3b",
            "Разбей задачу на максимум 4 выполнимых шага.",
            300
        ),
        (
            "Files",
            "qwen2.5:3b",
            "Определи, какие файлы и данные нужны. "
            "Ты пока НЕ можешь читать файловую систему. "
            "Не придумывай содержимое файлов.",
            250
        ),
        (
            "Coder",
            "qwen2.5-coder:7b",
            "Подготовь техническое решение или код, "
            "если задача требует программирования. "
            "Если код не нужен, предложи практическую реализацию.",
            850
        ),
        (
            "Writer",
            "qwen2.5:3b",
            "Улучши понятность и структуру решения. "
            "Не добавляй неподтверждённые факты.",
            250
        ),
        (
            "Teacher",
            "qwen2.5:3b",
            "Найди непонятные моменты и возможные "
            "логические ошибки. Дай короткие замечания.",
            300
        ),
        (
            "General",
            "qwen2.5:3b",
            "Собери финальный полезный ответ на задачу, "
            "учитывая результаты команды. "
            "Явно отделяй предложения от выполненных действий.",
            700
        )
    ]

    return [
        Agent(name, model, common + " " + instruction,
              max_tokens=limit)
        for name, model, instruction, limit in specs
    ]


async def run_team(task):
    task = task.strip()

    if not task or len(task) > 2000:
        return "Задача пуста или превышает 2000 символов."

    team = create_team()
    results = {}
    context = ""

    timeout = httpx.Timeout(
        300.0,
        connect=15.0
    )

    async with httpx.AsyncClient(timeout=timeout) as client:
        for agent in team:
            print(
                f"META TEAM: {agent.name} started "
                f"[{agent.model}]",
                flush=True
            )

            try:
                answer = await agent.run(
                    client, task, context
                )
                results[agent.name] = answer

                if agent.name != "General":
                    context += (
                        f"\n[{agent.name}]\n"
                        f"{answer[:2500]}\n"
                    )

                print(
                    f"META TEAM: {agent.name} finished",
                    flush=True
                )
            except Exception as exc:
                print(
                    f"META TEAM: {agent.name} failed: "
                    f"{type(exc).__name__}: {exc}",
                    flush=True
                )
                results[agent.name] = (
                    f"Ошибка выполнения: {type(exc).__name__}"
                )
                if agent.name == "General":
                    raise

    return (
        "## META Multi-Agent Team\n\n"
        "**Агенты:** Planner → Files → Coder → "
        "Writer → Teacher → General\n\n"
        "## Итог\n\n"
        + results["General"]
        + "\n\n---\n"
        "Все шесть агентов получили отдельные модельные "
        "контексты. На этом этапе изменения файлов "
        "и запуск команд не выполнялись."
    )
